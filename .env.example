# =============================================================================
# DeepGuard AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local frontend development:
#   cp .env.example .env.local
#
# IMPORTANT:
# - Never commit real keys, service-role secrets, or passwords to git.
# - The frontend only needs the project URL and publishable/anon client key.
# =============================================================================

# Supabase Project URL (e.g., https://<project-id>.supabase.co)
VITE_SUPABASE_URL=https://eehwhtxdnmngmaushwzv.supabase.co

# Supabase Publishable/Anon Key (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# DeepGuard AI FastAPI Backend Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000
